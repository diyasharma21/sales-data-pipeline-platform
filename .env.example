# ==============================================================================
# Automated Sales Data Engineering Pipeline - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your credentials.
# Note: NEVER commit the actual .env file with secrets into version control.

# PostgreSQL Database Credentials
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sales_dw

# Direct Database URL (Optional override; if set, takes precedence over the individual parameters above)
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/sales_dw
# Local fallback example (useful for quick local dry runs without active Postgres service):
# DATABASE_URL=sqlite:///data/sales_dw.db

# Pipeline File Configuration (relative to project root or absolute paths)
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
LOGS_DIR=logs

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
